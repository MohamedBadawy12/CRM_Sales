@model IEnumerable<CRM_Sales_Application.DTOs.ClientDto>
@{
    int pageSize = 10;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th><input type="checkbox" id="selectAll" onclick="toggleAll(this)" /></th>
                <th>#</th>
                <th>Client Name</th>
                <th>Phone</th>
                <th>Project</th>
                <th>Type</th>
                <th>Sales Agent</th>
                <th>Previous Agent</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                        No clients found
                    </td>
                </tr>
            }
            @{ int i = ((currentPage - 1) * pageSize) + 1; }
            @foreach (var client in Model)
            {
                <tr>
                    <td>
                        <input type="checkbox" class="client-checkbox"
                               value="@client.Id" onclick="updateSelection()" />
                    </td>
                    <td>@(i++)</td>
                    <td><strong>@client.ClientName</strong></td>
                    <td>@client.Phone</td>
                    <td>@client.ProjectName</td>
                    <td>
                        @if (client.Type == "Walk")
                        {
                            <span class="badge-walk"><i class="bi bi-person-walking me-1"></i>Walk-in</span>
                        }
                        else
                        {
                            <span class="badge-follow"><i class="bi bi-arrow-repeat me-1"></i>Follow-up</span>
                        }
                    </td>
                    <td>@client.AgentName</td>
                    <td>@(client.PreviousAgentName ?? "-")</td>
                    <td>@client.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a href="/Client/Edit/@client.Id" class="btn-edit me-1">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <form action="/Client/Delete/@client.Id"
                              method="post" style="display:inline" id="delete-@client.Id">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn-delete"
                                    onclick="confirmDelete('delete-@client.Id')">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted" style="font-size:13px;">
            Page @currentPage of @totalPages (@ViewBag.TotalAll total)
        </span>
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="#" onclick="loadPage(@(currentPage - 1)); return false;">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" href="#" onclick="loadPage(@p); return false;">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="#" onclick="loadPage(@(currentPage + 1)); return false;">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}