@model IEnumerable<CRM_Sales_Application.DTOs.ClientDto>
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Clients";
    var nextTeam = ViewBag.NextTeamInfo as CRM_Sales_Application.DTOs.NextTeamResultDto;
}

@Html.AntiForgeryToken()

<!-- Sequence Alert -->
@if (nextTeam != null && nextTeam.HasData)
{
    <div class="sequence-alert">
        <div class="sequence-alert-icon"><i class="bi bi-shuffle"></i></div>
        <div class="sequence-alert-text">
            <strong>Next Walk-in Turn:</strong>
            Team <span class="sequence-highlight">@nextTeam.NextTeamName</span>
            in <span class="sequence-highlight">@nextTeam.NextFloor</span>
            @if (nextTeam.LastTeamName != null)
            {
                <span class="sequence-sub">
                    (Last client went to @nextTeam.LastTeamName - @nextTeam.LastFloor)
                </span>
            }
        </div>
    </div>
}

<div class="content-card">
    <div class="content-card-header">
        <span class="content-card-title">
            <i class="bi bi-person-lines-fill me-2" style="color:var(--accent);"></i>
            Clients
        </span>
        <div class="d-flex gap-2">
            <a href="/Client/Deleted" class="btn-edit">
                <i class="bi bi-trash3"></i> Deleted Clients
            </a>
            <div class="dropdown">
                <button class="btn-edit dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-download"></i> Export
                </button>
                <ul class="dropdown-menu">
                    <li><h6 class="dropdown-header">All Records</h6></li>
                    <li>
                        <a class="dropdown-item" href="#" onclick="exportData('excel', false)">
                            <i class="bi bi-file-earmark-excel text-success me-2"></i>Excel
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="#" onclick="exportData('pdf', false)">
                            <i class="bi bi-file-earmark-pdf text-danger me-2"></i>PDF
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="#" onclick="exportData('print', false)">
                            <i class="bi bi-printer me-2"></i>Print
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">Selected Only</h6></li>
                    <li>
                        <a class="dropdown-item" href="#" onclick="exportData('excel', true)">
                            <i class="bi bi-file-earmark-excel text-success me-2"></i>Excel
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="#" onclick="exportData('pdf', true)">
                            <i class="bi bi-file-earmark-pdf text-danger me-2"></i>PDF
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="#" onclick="exportData('print', true)">
                            <i class="bi bi-printer me-2"></i>Print
                        </a>
                    </li>
                </ul>
            </div>
            <a href="/Client/Create" class="btn-primary-custom">
                <i class="bi bi-plus-lg"></i> Add Client
            </a>
        </div>
    </div>

    <div id="successAlertContainer">
        @if (TempData["Success"] != null)
        {
            <div class="alert-success-custom">
                <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
            </div>
        }
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs" id="filterTabs">
        <a href="#" onclick="setFilter('All'); return false;"
           class="filter-tab @(ViewBag.CurrentFilter == "All" ? "active" : "")" data-type="All">
            <i class="bi bi-grid me-1"></i> All (@ViewBag.TotalAll)
        </a>
        <a href="#" onclick="setFilter('Walk'); return false;"
           class="filter-tab @(ViewBag.CurrentFilter == "Walk" ? "active" : "")" data-type="Walk">
            <i class="bi bi-person-walking me-1"></i> Walk-in (@ViewBag.TotalWalk)
        </a>
        <a href="#" onclick="setFilter('Follow'); return false;"
           class="filter-tab @(ViewBag.CurrentFilter == "Follow" ? "active" : "")" data-type="Follow">
            <i class="bi bi-arrow-repeat me-1"></i> Follow-up (@ViewBag.TotalFollow)
        </a>
    </div>

    <!-- Search + Date Filter -->
    <div class="d-flex gap-2 flex-wrap align-items-center mb-3">
        <div class="search-box flex-grow-1">
            <i class="bi bi-search"></i>
            <input type="text" id="searchInput" value="@ViewBag.Search"
                   placeholder="Search clients..." class="form-control"
                   onkeyup="debounceSearch()" />
        </div>

        <select id="monthSelect" class="form-select" style="width:140px;" onchange="loadPage(1)">
            <option value="">All Months</option>
            @{
                var currentMonth = ViewBag.Month as int?;
                for (int m = 1; m <= 12; m++)
                {
                    var monthName = System.Globalization.CultureInfo
                    .CurrentCulture.DateTimeFormat.GetMonthName(m);
                    var isMonthSelected = currentMonth.HasValue && currentMonth.Value == m;
                    <option value="@m" selected="@isMonthSelected">@monthName</option>
                }
            }
        </select>

        <select id="yearSelect" class="form-select" style="width:110px;" onchange="loadPage(1)">
            <option value="">All Years</option>
            @{
                var currentYear = ViewBag.Year as int?;
                for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                {
                    var isYearSelected = currentYear.HasValue && currentYear.Value == y;
                    <option value="@y" selected="@isYearSelected">@y</option>
                }
            }
        </select>

        <button type="button" class="btn-edit" onclick="clearFilters()">
            <i class="bi bi-x-circle me-1"></i> Clear
        </button>
    </div>

    <div id="clientsTableContainer">
        @await Html.PartialAsync("_ClientsTablePartial", Model)
    </div>
</div>

@section Scripts {
    <script>
        let currentType = '@ViewBag.CurrentFilter';
        let searchTimeout;

        function loadPage(page) {
            const search = document.getElementById('searchInput').value;
            const month = document.getElementById('monthSelect').value;
            const year = document.getElementById('yearSelect').value;

            $.ajax({
                url: '/Client/Index',
                type: 'GET',
                data: { type: currentType, search: search, month: month, year: year, page: page },
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (html) {
                    document.getElementById('clientsTableContainer').innerHTML = html;
                    history.replaceState(null, '',
                        `/Client?type=${currentType}&search=${encodeURIComponent(search)}&month=${month}&year=${year}&page=${page}`);
                }
            });
        }

        function setFilter(type) {
            currentType = type;
            document.querySelectorAll('.filter-tab').forEach(tab => {
                tab.classList.toggle('active', tab.dataset.type === type);
            });
            loadPage(1);
        }

        function debounceSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => loadPage(1), 400); 
        }

        function clearFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('monthSelect').value = '';
            document.getElementById('yearSelect').value = '';
            loadPage(1);
        }


        function toggleAll(source) {
            document.querySelectorAll('.client-checkbox').forEach(cb => cb.checked = source.checked);
        }

        function updateSelection() {
            const all = document.querySelectorAll('.client-checkbox');
            const checked = document.querySelectorAll('.client-checkbox:checked');
            document.getElementById('selectAll').checked = all.length > 0 && all.length === checked.length;
        }

        function getSelectedIds() {
            return Array.from(document.querySelectorAll('.client-checkbox:checked'))
                .map(cb => cb.value).join(',');
        }

        function exportData(format, selectedOnly) {
            let ids = '';
            if (selectedOnly) {
                ids = getSelectedIds();
                if (!ids) { alert('Please select at least one client first.'); return; }
            }

            const search = document.getElementById('searchInput').value;
            const month = document.getElementById('monthSelect').value;
            const year = document.getElementById('yearSelect').value;

            if (format === 'print') {
                const params = new URLSearchParams({ ids, type: currentType, search, month, year });
                window.open('/Client/PrintView?' + params.toString(), '_blank');
                return;
            }

            const form = document.createElement('form');
            form.method = 'POST';
            form.action = format === 'excel' ? '/Client/ExportExcel' : '/Client/ExportPdf';

            const fields = { ids, type: currentType, search, month, year };
            for (const key in fields) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = key;
                input.value = fields[key];
                form.appendChild(input);
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                const tokenInput = document.createElement('input');
                tokenInput.type = 'hidden';
                tokenInput.name = '__RequestVerificationToken';
                tokenInput.value = token.value;
                form.appendChild(tokenInput);
            }

            document.body.appendChild(form);
            form.submit();
            document.body.removeChild(form);
        }

        function confirmDelete(formId) {
            if (confirm('Are you sure you want to delete this item?')) {
                const form = document.getElementById(formId);
                const url = form.action;
                const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: { __RequestVerificationToken: token },
                    success: function () {
                        loadPage(@ViewBag.CurrentPage); 
                    },
                    error: function () {
                        alert('Error deleting client.');
                    }
                });
            }
        }
    </script>
}