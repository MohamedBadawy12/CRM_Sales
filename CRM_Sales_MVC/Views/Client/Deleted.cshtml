@model IEnumerable<CRM_Sales_Application.DTOs.ClientDto>
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Deleted Clients";
}

@Html.AntiForgeryToken()

<div class="content-card">
    <div class="content-card-header">
        <span class="content-card-title">
            <i class="bi bi-trash3 me-2" style="color:#dc3545;"></i>
            Deleted Clients
            <span style="color:#aaa; font-size:13px; font-weight:400;">
                (@Model.Count() total)
            </span>
        </span>
        <a href="/Client" class="btn-edit">
            <i class="bi bi-arrow-right"></i> Back to Clients
        </a>
    </div>

    <div id="successAlertContainer">
        @if (TempData["Success"] != null)
        {
            <div class="alert-success-custom">
                <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-trash3 fs-1 d-block mb-3" style="opacity:0.3;"></i>
            No deleted clients found
        </div>
    }
    else
    {
        <!-- Bulk Actions Bar -->
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <input type="checkbox" id="selectAll" onclick="toggleAll(this)" />
                <label for="selectAll" style="font-size:13px; color:#666;">Select All</label>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn-edit" onclick="restoreSelected()">
                    <i class="bi bi-arrow-counterclockwise"></i> Restore Selected
                </button>
                <button type="button" class="btn-delete" onclick="permanentDeleteSelected(false)">
                    <i class="bi bi-trash3"></i> Delete Selected Permanently
                </button>
                <button type="button" class="btn-delete" onclick="permanentDeleteSelected(true)"
                        style="background:rgba(220,53,69,0.2);">
                    <i class="bi bi-exclamation-triangle"></i> Delete All Permanently
                </button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th></th>
                        <th>#</th>
                        <th>Client Name</th>
                        <th>Phone</th>
                        <th>Project</th>
                        <th>Type</th>
                        <th>Sales Agent</th>
                        <th>Deleted At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                    }
                    @foreach (var client in Model)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" class="deleted-checkbox"
                                       value="@client.Id" onclick="updateSelection()" />
                            </td>
                            <td>@(i++)</td>
                            <td><strong>@client.ClientName</strong></td>
                            <td>@client.Phone</td>
                            <td>@client.ProjectName</td>
                            <td>
                                @if (client.Type == "Walk")
                                {
                                    <span class="badge-walk"><i class="bi bi-person-walking me-1"></i>Walk-in</span>
                                }
                                else
                                {
                                    <span class="badge-follow"><i class="bi bi-arrow-repeat me-1"></i>Follow-up</span>
                                }
                            </td>
                            <td>@client.AgentName</td>
                            <td>@(client.DeletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td>
                                <button type="button" class="btn-edit me-1"
                                        onclick="restoreOne('@client.Id')">
                                    <i class="bi bi-arrow-counterclockwise"></i> Restore
                                </button>
                                <button type="button" class="btn-delete"
                                        onclick="permanentDeleteOne('@client.Id')">
                                    <i class="bi bi-trash3"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        function toggleAll(source) {
            document.querySelectorAll('.deleted-checkbox').forEach(cb => cb.checked = source.checked);
        }

        function updateSelection() {
            const all = document.querySelectorAll('.deleted-checkbox');
            const checked = document.querySelectorAll('.deleted-checkbox:checked');
            document.getElementById('selectAll').checked = all.length > 0 && all.length === checked.length;
        }

        function getSelectedIds() {
            return Array.from(document.querySelectorAll('.deleted-checkbox:checked'))
                .map(cb => cb.value).join(',');
        }

        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]').value;
        }

        function restoreOne(id) {
            if (!confirm('Restore this client back to the active list?')) return;

            $.ajax({
                url: '/Client/Restore',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: getToken() },
                success: function () { location.reload(); },
                error: function () { alert('Error restoring client.'); }
            });
        }

        function restoreSelected() {
            const ids = getSelectedIds();
            if (!ids) { alert('Please select at least one client.'); return; }
            if (!confirm('Restore selected clients?')) return;

            $.ajax({
                url: '/Client/RestoreSelected',
                type: 'POST',
                data: { ids: ids, __RequestVerificationToken: getToken() },
                success: function () { location.reload(); },
                error: function () { alert('Error restoring clients.'); }
            });
        }

        function permanentDeleteOne(id) {
            if (!confirm('⚠️ This will PERMANENTLY delete this client from the database. This action cannot be undone. Continue?')) return;

            $.ajax({
                url: '/Client/PermanentDelete',
                type: 'POST',
                data: { id: id, __RequestVerificationToken: getToken() },
                success: function () { location.reload(); },
                error: function () { alert('Error deleting client.'); }
            });
        }

        function permanentDeleteSelected(deleteAll) {
            let ids = '';

            if (deleteAll) {
                ids = Array.from(document.querySelectorAll('.deleted-checkbox'))
                    .map(cb => cb.value).join(',');
                if (!confirm('⚠️ This will PERMANENTLY delete ALL deleted clients from the database. This action cannot be undone. Continue?')) return;
            } else {
                ids = getSelectedIds();
                if (!ids) { alert('Please select at least one client.'); return; }
                if (!confirm('⚠️ This will PERMANENTLY delete the selected clients. This action cannot be undone. Continue?')) return;
            }

            $.ajax({
                url: '/Client/PermanentDeleteSelected',
                type: 'POST',
                data: { ids: ids, __RequestVerificationToken: getToken() },
                success: function () { location.reload(); },
                error: function () { alert('Error deleting clients.'); }
            });
        }
    </script>
}