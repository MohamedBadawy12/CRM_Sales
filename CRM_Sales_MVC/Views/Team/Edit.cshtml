@model CRM_Sales_Application.DTOs.UpdateTeamDto
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Edit Team";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="form-card">
            <div class="content-card-header">
                <span class="content-card-title">
                    <i class="bi bi-pencil me-2" style="color:#e94560;"></i> Edit Team
                </span>
                <a asp-action="Index" class="btn-edit">
                    <i class="bi bi-arrow-right"></i> Back
                </a>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="TeamName" class="form-label">Team Name</label>
                    <input asp-for="TeamName" class="form-control" />
                    <span asp-validation-for="TeamName" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Floor" class="form-label">Floor</label>
                    <select asp-for="Floor" class="form-select">
                        <option value="">-- Select Floor --</option>
                        @foreach (var floor in ViewBag.Floors)
                        {
                            <option value="@floor.Value">@floor.Text</option>
                        }
                    </select>
                    <span asp-validation-for="Floor" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-primary-custom w-100">
                    <i class="bi bi-check-lg me-2"></i> Update Team
                </button>
            </form>
        </div>
    </div>
</div>