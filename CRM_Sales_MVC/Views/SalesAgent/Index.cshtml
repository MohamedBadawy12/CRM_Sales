@model IEnumerable<CRM_Sales_Application.DTOs.SalesAgentDto>
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Sales Agents";
}

@Html.AntiForgeryToken()

<div class="content-card">
    <div class="content-card-header">
        <span class="content-card-title">
            <i class="bi bi-person-badge me-2" style="color:var(--accent);"></i>
            Sales Agents
            <span style="color:#aaa; font-size:13px; font-weight:400;">
                (@ViewBag.TotalCount total)
            </span>
        </span>
        <a href="/SalesAgent/Create" class="btn-primary-custom">
            <i class="bi bi-plus-lg"></i> Add Agent
        </a>
    </div>

    <div id="successAlertContainer">
        @if (TempData["Success"] != null)
        {
            <div class="alert-success-custom">
                <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
            </div>
        }
    </div>

    <!-- Search -->
    <div class="d-flex gap-2 mb-4">
        <div class="search-box flex-grow-1">
            <i class="bi bi-search"></i>
            <input type="text" id="searchInput" value="@ViewBag.Search"
                   placeholder="Search by name, team, role..."
                   class="form-control" onkeyup="debounceSearch()" />
        </div>
        <button type="button" class="btn-edit" onclick="clearFilters()">
            <i class="bi bi-x-circle me-1"></i> Clear
        </button>
    </div>

    <!-- ✅ الجزء اللي يتحدث بـ AJAX -->
    <div id="agentsTableContainer">
        @await Html.PartialAsync("_SalesAgentsTablePartial", Model)
    </div>
</div>

@section Scripts {
    <script>
        let searchTimeout;

        function loadPage(page) {
            const search = document.getElementById('searchInput').value;

            $.ajax({
                url: '/SalesAgent/Index',
                type: 'GET',
                data: { search: search, page: page },
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                success: function (html) {
                    document.getElementById('agentsTableContainer').innerHTML = html;
                    history.replaceState(null, '',
                        `/SalesAgent?search=${encodeURIComponent(search)}&page=${page}`);
                }
            });
        }

        function debounceSearch() {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => loadPage(1), 400);
        }

        function clearFilters() {
            document.getElementById('searchInput').value = '';
            loadPage(1);
        }

        function confirmDelete(formId) {
            if (confirm('Are you sure you want to delete this item?')) {
                const form = document.getElementById(formId);
                const url = form.action;
                const token = form.querySelector('input[name="__RequestVerificationToken"]').value;

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: { __RequestVerificationToken: token },
                    success: function () {
                        loadPage(@(ViewBag.CurrentPage ?? 1));
                    },
                    error: function () {
                        alert('Error deleting agent.');
                    }
                });
            }
        }
    </script>
}