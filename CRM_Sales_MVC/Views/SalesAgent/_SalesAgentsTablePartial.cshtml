@model IEnumerable<CRM_Sales_Application.DTOs.SalesAgentDto>
@{
    int pageSize = 10;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Agent Name</th>
                <th>Role</th>
                <th>Team</th>
                <th>Team Leader</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                        No agents found
                    </td>
                </tr>
            }
            @{ int i = ((currentPage - 1) * pageSize) + 1; }
            @foreach (var agent in Model)
            {
                <tr>
                    <td>@(i++)</td>
                    <td><strong>@agent.AgentName</strong></td>
                    <td>
                        @if (agent.Role == "TeamLeader")
                        {
                            <span class="badge-leader">
                                <i class="bi bi-star-fill me-1"></i> Team Leader
                            </span>
                        }
                        else
                        {
                            <span class="badge-agent">
                                <i class="bi bi-person me-1"></i> Agent
                            </span>
                        }
                    </td>
                    <td>@(agent.TeamName ?? "-")</td>
                    <td>@(agent.LeaderName ?? "-")</td>
                    <td>
                        <a href="/SalesAgent/Edit/@agent.Id" class="btn-edit me-1">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <form action="/SalesAgent/Delete/@agent.Id"
                              method="post" style="display:inline" id="delete-@agent.Id">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn-delete"
                                    onclick="confirmDelete('delete-@agent.Id')">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (totalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted" style="font-size:13px;">
            Page @currentPage of @totalPages (@ViewBag.TotalCount agents)
        </span>
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="#" onclick="loadPage(@(currentPage - 1)); return false;">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" href="#" onclick="loadPage(@p); return false;">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="#" onclick="loadPage(@(currentPage + 1)); return false;">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}