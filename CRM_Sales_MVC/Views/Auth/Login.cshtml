@model CRM_Sales_Application.DTOs.LoginDto
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<div class="auth-card">
    <div class="auth-logo">
        <img src="~/images/logoTMG.png" alt="Talaat Moustafa Group" />
    </div>

    <p class="auth-title">Rehap Reception - Sales Management</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Login" asp-controller="Auth" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">UserName</label>
            <input asp-for="Email" class="form-control" placeholder="" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <div class="input-group">
                <input asp-for="Password" class="form-control"
                       type="password" id="passwordInput" />
                <button class="btn-toggle-pass" type="button"
                        onclick="togglePassword('passwordInput','eyeIcon')">
                    <i class="bi bi-eye" id="eyeIcon"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check">
            <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
            <label class="form-check-label">Remember me</label>
        </div>

        <button type="submit" class="btn-auth">LOG ON</button>

        <a asp-action="Register" asp-controller="Auth" class="auth-forgot">
            Don't have an account? Register
        </a>
    </form>
</div>