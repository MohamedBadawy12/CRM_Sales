@model CRM_Sales_Application.DTOs.RegisterDto
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register";
}

<div class="auth-card">
    <div class="auth-logo">
        <img src="~/images/logoTMG.png" alt="Talaat Moustafa Group" />
    </div>

    <p class="auth-title">Rehap Reception - Create Account</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Register" asp-controller="Auth" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Email Address</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <div class="input-group">
                <input asp-for="Password" class="form-control"
                       type="password" id="passwordInput" />
                <button class="btn-toggle-pass" type="button"
                        onclick="togglePassword('passwordInput','eyeIcon1')">
                    <i class="bi bi-eye" id="eyeIcon1"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label class="form-label">Confirm Password</label>
            <div class="input-group">
                <input asp-for="ConfirmPassword" class="form-control"
                       type="password" id="confirmInput" />
                <button class="btn-toggle-pass" type="button"
                        onclick="togglePassword('confirmInput','eyeIcon2')">
                    <i class="bi bi-eye" id="eyeIcon2"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-auth">CREATE ACCOUNT</button>

        <div class="auth-bottom">
            Already have an account?
            <a asp-action="Login" asp-controller="Auth" class="auth-link">Sign In</a>
        </div>
    </form>
</div>