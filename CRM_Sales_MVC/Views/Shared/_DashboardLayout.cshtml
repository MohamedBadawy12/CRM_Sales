<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CRM Sales</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <link href="~/css/dashboard.css" rel="stylesheet" />
</head>
<body>
    <!-- Sidebar - LEFT -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-logo">
            <div class="sidebar-logo-icon">
                <img src="~/images/logoTMG.png" alt="Talaat Moustafa Group" />
            </div>
            <div class="sidebar-logo-text">
                CRM Sales
                <span>Rehap Sales Management System</span>
            </div>
        </div>

        <div class="sidebar-section">MAIN</div>
        <a href="/Dashboard" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
            <i class="bi bi-grid"></i> Dashboard
        </a>

        <div class="sidebar-section">MANAGEMENT</div>
        <a href="/Team" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Team" ? "active" : "")">
            <i class="bi bi-people"></i> Teams
        </a>
        <a href="/SalesAgent" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SalesAgent" ? "active" : "")">
            <i class="bi bi-person-badge"></i> Sales Agents
        </a>
        <a href="/Project" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Project" ? "active" : "")">
            <i class="bi bi-building"></i> Projects
        </a>
        <a href="/Client" class="sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Client" ? "active" : "")">
            <i class="bi bi-person-lines-fill"></i> Clients
        </a>

        <div class="sidebar-logout">
            <form asp-action="Logout" asp-controller="Auth" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="sidebar-item w-100 border-0"
                        style="background: rgba(26,115,232,0.1); color: #1a73e8;">
                    <i class="bi bi-box-arrow-left"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- Topbar -->
    <div class="topbar">
        <div class="d-flex align-items-center gap-3">
            <button class="btn d-md-none p-1" onclick="toggleSidebar()">
                <i class="bi bi-list fs-4"></i>
            </button>
            <span class="topbar-title">@ViewData["Title"]</span>
        </div>
        <div class="topbar-right">
            <div class="topbar-avatar">
                @User.Identity?.Name?.FirstOrDefault()
            </div>
            <span class="topbar-username">@User.Identity?.Name</span>
        </div>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="~/js/app.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>