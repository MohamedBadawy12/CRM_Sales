@model CRM_Sales_Application.DTOs.UpdateProjectDto
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Edit Project";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="form-card">
            <div class="content-card-header">
                <span class="content-card-title">
                    <i class="bi bi-pencil me-2" style="color:#e94560;"></i>
                    Edit Project
                </span>
                <a asp-action="Index" class="btn-edit">
                    <i class="bi bi-arrow-right"></i> Back
                </a>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="ProjectName" class="form-label">Project Name</label>
                    <input asp-for="ProjectName" class="form-control" />
                    <span asp-validation-for="ProjectName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label">Location</label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Area" class="form-label">Area</label>
                    <input asp-for="Area" class="form-control" />
                    <span asp-validation-for="Area" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-primary-custom w-100">
                    <i class="bi bi-check-lg me-2"></i> Update Project
                </button>
            </form>
        </div>
    </div>
</div>